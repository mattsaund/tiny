# Maintainer: Matthew Saunders <matt dot saunders dot 963 at gmail dot com>

# tiny's own prebuilt release, as GitHub Actions built it for each tag: the
# same binary the install script gets. From source, see the tiny-ide package.

pkgname=tiny-ide-bin
pkgver=0.6.7
pkgrel=1
pkgdesc="An IDE, text editor, knowledge manager and file browser in the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/mattsaund/tiny"
license=('MIT')
depends=('gcc-libs' 'glibc')
optdepends=(
  'git: the git window, and a map that leaves out what .gitignore names'
  'github-cli: publishing a project to a new GitHub repository'
  'xdg-utils: opening pictures, PDFs and links in their own programs'
  'ffmpeg: how long a video or a sound is'
  'wl-clipboard: the system clipboard on Wayland'
  'xclip: the system clipboard on X11'
)
provides=('tiny-ide')
# Arch's own tiny, an IRC client, is a program called tiny as well.
conflicts=('tiny-ide' 'tiny')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/tiny-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/tiny-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('8ec66eb8abba0accfce75299cff0b24de8c040f2cae7f0e55351247c0e947cf5')
sha256sums_aarch64=('5b9cb0ceee84da0c61eb5027c3cbb7e82e6ba672a1c9d74d3a860827d4e33636')

package() {
  install -Dm755 tiny "$pkgdir/usr/bin/tiny"
  install -Dm644 tiny.1 "$pkgdir/usr/share/man/man1/tiny.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
