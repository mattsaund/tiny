# Maintainer: Matthew Saunders <matt dot saunders dot 963 at gmail dot com>

# tiny, built from the source of each tag. Prebuilt, see the tiny-ide-bin
# package.

pkgname=tiny-ide
_name=tiny
pkgver=0.6.9
pkgrel=1
pkgdesc="An IDE, text editor, knowledge manager and file browser in the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/mattsaund/tiny"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
checkdepends=('git')
optdepends=(
  'git: the git window, and a map that leaves out what .gitignore names'
  'github-cli: publishing a project to a new GitHub repository'
  'xdg-utils: opening pictures, PDFs and links in their own programs'
  'ffmpeg: how long a video or a sound is'
  'wl-clipboard: the system clipboard on Wayland'
  'xclip: the system clipboard on X11'
)
# Arch's own tiny, an IRC client, is a program called tiny as well.
conflicts=('tiny-ide-bin' 'tiny')
# The grammars behind the map are C, built by cargo; makepkg's own LTO
# flags on them do not link with Rust's.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('132ab023fdbddc257941a275b147998ba81bde893ddad923ed5ad8f06ebe6056')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$_name-$pkgver"
  install -Dm755 target/release/tiny "$pkgdir/usr/bin/tiny"
  install -Dm644 docs/tiny.1 "$pkgdir/usr/share/man/man1/tiny.1"
  # The menu entry and the icon, in every size there is.
  install -Dm644 packaging/desktop/tiny.desktop "$pkgdir/usr/share/applications/tiny.desktop"
  for icon in packaging/desktop/icons/hicolor/*/apps/tiny.*; do
    install -Dm644 "$icon" "$pkgdir/usr/share/${icon#packaging/desktop/}"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
