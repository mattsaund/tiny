	optdepends = xdg-utils: opening pictures, PDFs and links in their own programs
	optdepends = ffmpeg: how long a video or a sound is
	optdepends = wl-clipboard: the system clipboard on Wayland
	optdepends = xclip: the system clipboard on X11
	conflicts = tiny-ide-bin
	conflicts = tiny
	options = !lto
