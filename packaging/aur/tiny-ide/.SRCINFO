pkgbase = tiny-ide
	pkgdesc = An IDE, text editor, knowledge manager and file browser in the terminal
	pkgver = 0.7.0
	pkgrel = 1
	url = https://github.com/mattsaund/tiny
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = git
	makedepends = cargo
	depends = gcc-libs
	depends = glibc
